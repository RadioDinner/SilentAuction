# ---------------------------------------------------------------------------
# Silent Auction Dashboard — environment variables
# Copy this file to ".env.local" for local dev, and set the same values in
# Vercel (Project Settings -> Environment Variables) for production.
# ---------------------------------------------------------------------------

# The ID of your Google Sheet. It's the long string in the sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Service account email, e.g. auction-bot@my-project.iam.gserviceaccount.com
# Share your Google Sheet with this email. Viewer access is enough for the
# read-only dashboard; grant EDITOR if you want to use "Save to Sheet" from the
# /admin console (see ADMIN_TOKEN below).
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The service account private key, from the downloaded JSON key file.
# Paste the WHOLE key including the BEGIN/END lines and the literal "\n"s.
#  - In THIS .env file: keep the surrounding double quotes (as below).
#  - In the VERCEL UI: paste the value WITHOUT the surrounding quotes.
# (The app also auto-strips stray quotes and fixes \n, just in case.)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Set to 1 to force built-in demo data and ignore the sheet entirely.
# Leave blank/unset for normal operation. Handy for previewing the dashboard
# before the sheet is wired up.
AUCTION_DEMO=

# Enables live editing: the /admin "Save to Sheet" button writes bids/times/
# settings back to the Google Sheet. Leave UNSET to keep the app fully
# read-only (the Save button is then disabled and the API returns 503).
# Pick a long random string; whoever runs the console enters it once.
# The service account must have EDITOR access to the sheet for writes to land.
ADMIN_TOKEN=

# How often (seconds) the dashboard re-fetches state from the server.
# Defaults to 3 if unset.
NEXT_PUBLIC_POLL_SECONDS=3
